<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
		Latios' Arsenal — 机械族废料回收发射器
		BL 系列：无托式发射器（较短射程、较轻、精度略低）
		HL 系列：肩扛重型发射器（射程/精度/弹头速度/伤害更高，重量更重）
		两者均发射 CE 已有的机械族重型弹药，逐发装弹。
	-->
  <!-- ==================== BL-66 热能弹发射器 ==================== -->
  <ThingDef ParentName="BaseHumanMakeableGun" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>Latios_BL66_Thermal</defName>
    <label>compact mechanoid thermal launcher</label>
    <description>A bullpup thermal launcher built from salvaged mechanoid parts. It feeds 66mm thermal bolts from a six-round rotary magazine, one bolt at a time. Part of each bolt's charge is burned as propellant instead of payload, so it hits a little softer than the mechanoid original, but the round flies flatter and faster.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Weapons/Latios/BL66</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconPath>UI/Icons/Latios/BL66_Icon</uiIconPath>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>30000</WorkToMake>
      <Mass>7.5</Mass>
      <MarketValue>1250</MarketValue>
      <SightsEfficiency>1.0</SightsEfficiency>
      <ShotSpread>0.16</ShotSpread>
      <SwayFactor>1.05</SwayFactor>
      <Bulk>7.0</Bulk>
      <RangedWeapon_Cooldown>1.9</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ChunkMechanoidSlag>2</ChunkMechanoidSlag>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <researchPrerequisite>BasicMechtech</researchPrerequisite>
      <researchPrerequisites>
        <li>Fabrication</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>310</displayPriority>
    </recipeMaker>
    <thingSetMakerTags>
      <li>RewardStandardQualitySuper</li>
    </thingSetMakerTags>
    <weaponTags>
      <li>SpacerGun</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <verbs>
      <li Class="CombatExtended.VerbPropertiesCE">
        <verbClass>CombatExtended.Verb_ShootCE</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Latios_Bullet_BL66_Thermal</defaultProjectile>
        <warmupTime>1.3</warmupTime>
        <range>42</range>
        <minRange>4</minRange>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <burstShotCount>1</burstShotCount>
        <soundCast>InfernoCannon_Fire</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
        <recoilAmount>2.4</recoilAmount>
        <ai_AvoidFriendlyFireRadius>4</ai_AvoidFriendlyFireRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
      </li>
    </verbs>
    <comps>
      <li Class="CombatExtended.CompProperties_AmmoUser">
        <magazineSize>6</magazineSize>
        <reloadOneAtATime>true</reloadOneAtATime>
        <reloadTime>1.2</reloadTime>
        <ammoSet>Latios_AmmoSet_BL66_Thermal</ammoSet>
      </li>
      <li Class="CombatExtended.CompProperties_FireModes">
        <aiUseBurstMode>FALSE</aiUseBurstMode>
        <aiAimMode>AimedShot</aiAimMode>
      </li>
      <li Class="LatiosArsenal.CompProperties_LobMode">
        <warmupMultiplier>1.2</warmupMultiplier>
        <cooldownMultiplier>1.2</cooldownMultiplier>
        <lobProjectileSuffix>_Lob</lobProjectileSuffix>
      </li>
    </comps>
    <tools>
      <li Class="CombatExtended.ToolCE">
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2.0</cooldownTime>
        <armorPenetrationBlunt>3.5</armorPenetrationBlunt>
        <linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
      </li>
      <li Class="CombatExtended.ToolCE">
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2.0</cooldownTime>
        <armorPenetrationBlunt>3.5</armorPenetrationBlunt>
        <linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
      </li>
    </tools>
  </ThingDef>
